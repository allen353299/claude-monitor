<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClaudeMonitor.App.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Rectangle.wave-block">
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Rectangle.wave-block.lit3">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Rectangle.wave-block.lit2">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Rectangle.wave-block.lit">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/ClaudeMonitor.ico"
                      ToolTipText="Claude Monitor"
                      Clicked="OnTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Popover"
                                        ToggleType="CheckBox"
                                        Click="OnTrayPopoverClick" />
                        <NativeMenuItem Header="Dashboard"
                                        ToggleType="CheckBox"
                                        Click="OnTrayDashboardClick" />
                        <NativeMenuItem Header="-" />
                        <NativeMenuItem Header="Quit" Click="OnTrayQuitClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
