<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeMonitor.App.ViewModels"
        xmlns:theme="clr-namespace:ClaudeMonitor.App.Theme"
        x:Class="ClaudeMonitor.App.Views.DashboardWindow"
        x:DataType="vm:DashboardViewModel"
        Width="900" Height="620"
        MinWidth="640" MinHeight="420"
        Background="#0f0f0f"
        Title="Claude Monitor"
        Icon="avares://ClaudeMonitor.App/Assets/ClaudeMonitor.ico">

    <Window.Resources>
        <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Rectangle.dot-urgent">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.glow-urgent">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.glow-done">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.14" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.session-card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0a0a0a" />
        </Style>
        <Style Selector="Button.session-card:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#141414" />
        </Style>
    </Window.Styles>

    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                Background="Transparent"
                Padding="0">
            <TabItem Header="MONITOR">
                <Grid Margin="12" DataContext="{Binding Monitor.Popover}">
                    <TextBlock Text="NO ACTIVE SESSIONS"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="#666666"
                               LetterSpacing="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsEmpty}" />
                    <Border BorderBrush="#222222"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsVisible="{Binding !IsEmpty}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionVm">
                                        <Grid Opacity="{Binding CardOpacity}">
                                            <Button Classes="session-card"
                                                    Background="Transparent"
                                                    BorderBrush="#222222"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    HorizontalAlignment="Stretch"
                                                    Cursor="Hand"
                                                    CornerRadius="0"
                                                    IsEnabled="{Binding IsLive}"
                                                    Command="{Binding $parent[ItemsControl].((vm:PopoverViewModel)DataContext).ActivateSessionCommand}"
                                                    CommandParameter="{Binding Id.Value}">
                                                <Grid>
                                                    <Rectangle Fill="{x:Static theme:StatusPalette.Attention}"
                                                               Opacity="0"
                                                               IsHitTestVisible="False"
                                                               Classes.glow-urgent="{Binding ShouldGlowUrgent}" />
                                                    <Rectangle Fill="{x:Static theme:StatusPalette.Done}"
                                                               Opacity="0"
                                                               IsHitTestVisible="False"
                                                               Classes.glow-done="{Binding ShouldGlowDone}" />
                                                    <Border Padding="16,9">
                                                        <StackPanel Spacing="3">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Rectangle Width="6" Height="6"
                                                                           Fill="{Binding StatusColor}"
                                                                           Classes.dot-urgent="{Binding ShouldGlowUrgent}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding PrimaryLabel}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#ffffff"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusLabel}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           Foreground="#888888"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding PendingTool}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           Foreground="{x:Static theme:StatusPalette.Attention}"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding PendingTool, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ProjectPath}"
                                                                       Margin="14,0,0,0"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11"
                                                                       Foreground="#888888"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding HasProjectPath}" />
                                                            <TextBlock Text="{Binding RecapOrLatest}"
                                                                       Margin="14,0,0,0"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="10"
                                                                       Foreground="#666666"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding HasRecapOrLatest}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <Button Content="&#xE8A5;"
                                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    Width="22" Height="22"
                                                    Padding="0"
                                                    Margin="0,4,12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="Transparent"
                                                    Foreground="#666666"
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="View conversation"
                                                    Command="{Binding $parent[ItemsControl].((vm:PopoverViewModel)DataContext).ViewConversationCommand}"
                                                    CommandParameter="{Binding Id.Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="HISTORY">
                <Grid RowDefinitions="Auto,*" DataContext="{Binding History}" Margin="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText}"
                                 PlaceholderText="Search display / project / session id..."
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="11" />
                        <Button Grid.Column="1"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Margin="8,0,0,0"
                                FontFamily="{StaticResource MonoFont}"
                                FontSize="11" />
                    </Grid>
                    <Border Grid.Row="1"
                            BorderBrush="#222222"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryItemVm">
                                        <Button Classes="session-card"
                                                Background="Transparent"
                                                BorderBrush="#222222"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8"
                                                HorizontalContentAlignment="Stretch"
                                                HorizontalAlignment="Stretch"
                                                Cursor="Hand"
                                                CornerRadius="0"
                                                IsEnabled="{Binding HasJsonlPath}"
                                                Click="OnHistoryRowClick"
                                                Tag="{Binding}">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding PrimaryLabel}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#ffffff"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ProjectPath, StringFormat='({0})'}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11"
                                                               Foreground="#888888"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailLine}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10"
                                                           Foreground="#888888"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MetaLine}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="9"
                                                           Foreground="#555555" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="COST">
                <Grid RowDefinitions="Auto,*" DataContext="{Binding Cost}" Margin="12">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding GrandTotalText, StringFormat='Total: {0}'}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#ffffff"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                FontFamily="{StaticResource MonoFont}"
                                FontSize="11" />
                    </Grid>
                    <Border Grid.Row="1"
                            BorderBrush="#222222"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionCostVm">
                                        <Border BorderBrush="#222222"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8">
                                            <Grid ColumnDefinitions="*,110,90,90,90,90">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding ProjectPath}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11"
                                                               Foreground="#cccccc"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Model}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="9"
                                                                   Foreground="#888888" />
                                                        <TextBlock Text="{Binding LastActivityText}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="9"
                                                                   Foreground="#666666" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding UsdText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#22c55e"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding InputText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10"
                                                           Foreground="#888888"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding OutputText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10"
                                                           Foreground="#888888"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding CacheReadText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10"
                                                           Foreground="#666666"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding CacheWriteText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10"
                                                           Foreground="#666666"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="MEMORY">
                <Grid RowDefinitions="Auto,*" DataContext="{Binding Memory}" Margin="12">
                    <Button Grid.Row="0"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,8"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="11" />
                    <Grid Grid.Row="1" ColumnDefinitions="260,*">
                    <Border Grid.Column="0"
                            BorderBrush="#222222"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding Projects}"
                                     SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemoryProjectVm">
                                        <StackPanel Spacing="2" Margin="4">
                                            <TextBlock Text="{Binding DisplayPath}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       Foreground="#cccccc"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FileCountText}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9"
                                                       Foreground="#666666" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Column="1" Margin="12,0,0,0" RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                BorderBrush="#222222"
                                BorderThickness="1"
                                CornerRadius="4"
                                MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedProject.Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MemoryFileVm">
                                            <Button Background="Transparent"
                                                    BorderBrush="#222222"
                                                    BorderThickness="0,0,0,1"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="8,6"
                                                    Click="OnMemoryFileClick"
                                                    Tag="{Binding}">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="#cccccc" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1"
                                BorderBrush="#222222"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,8,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <SelectableTextBlock Text="{Binding SelectedFile.Content, FallbackValue='Select a file.'}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="11"
                                                     Foreground="#cccccc"
                                                     TextWrapping="Wrap"
                                                     Padding="12" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="SETTINGS">
                <StackPanel DataContext="{Binding Settings}" Margin="24" Spacing="20" MaxWidth="520" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Version"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   Foreground="#666666" />
                        <TextBlock Text="{Binding CurrentVersion, StringFormat='Current: {0}'}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   Foreground="#ffffff" />
                        <TextBlock Text="{Binding LatestVersion, StringFormat='Latest:  {0}'}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   Foreground="#cccccc"
                                   IsVisible="{Binding LatestVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Check for update"
                                    Command="{Binding CheckForUpdateCommand}"
                                    IsEnabled="{Binding !IsChecking}"
                                    FontFamily="{StaticResource MonoFont}"
                                    FontSize="11" />
                            <TextBlock Text="{Binding UpdateStatus}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="#888888"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Open release page"
                                Click="OnOpenReleaseClick"
                                Tag="{Binding LatestReleaseUrl}"
                                IsVisible="{Binding HasUpdate}"
                                FontFamily="{StaticResource MonoFont}"
                                FontSize="11"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="CONVERSATION" IsVisible="{Binding CurrentConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid DataContext="{Binding CurrentConversation}" RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="#141414"
                            BorderBrush="#222222"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#ffffff"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      Content="thinking"
                                      IsChecked="{Binding ShowThinking}"
                                      Foreground="#888888"
                                      FontFamily="{StaticResource MonoFont}"
                                      FontSize="10"
                                      Margin="12,0,0,0" />
                            <CheckBox Grid.Column="2"
                                      Content="tools"
                                      IsChecked="{Binding ShowToolCalls}"
                                      Foreground="#888888"
                                      FontFamily="{StaticResource MonoFont}"
                                      FontSize="10"
                                      Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
                        <ItemsControl ItemsSource="{Binding VisibleMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MessageVm">
                                    <Border BorderBrush="#222222"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,0,0,8"
                                            Padding="10">
                                        <StackPanel Spacing="4">
                                            <Border Background="{Binding AccentColor}"
                                                    Height="2"
                                                    HorizontalAlignment="Stretch" />
                                            <TextBlock Text="{Binding Header}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="{Binding AccentColor}"
                                                       FontWeight="SemiBold" />
                                            <SelectableTextBlock Text="{Binding Body}"
                                                                 FontFamily="{StaticResource MonoFont}"
                                                                 FontSize="11"
                                                                 Foreground="#cccccc"
                                                                 TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
    </TabControl>
</Window>
