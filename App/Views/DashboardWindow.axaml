<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeMonitor.App.ViewModels"
        x:Class="ClaudeMonitor.App.Views.DashboardWindow"
        x:DataType="vm:DashboardViewModel"
        Width="900" Height="620"
        MinWidth="640" MinHeight="420"
        Background="#0f0f0f"
        Title="Claude Monitor"
        Icon="avares://ClaudeMonitor.App/Assets/ClaudeMonitor.ico">

    <Window.Resources>
        <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="Transparent"
                    Padding="0">
            <TabItem Header="MONITOR">
                <Grid Margin="0,8,0,0">
                    <TextBlock Text="Live session view — reuse the popover data."
                               Foreground="#666666"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </TabItem>
            <TabItem Header="HISTORY">
                <Grid RowDefinitions="Auto,*" DataContext="{Binding History}" Margin="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText}"
                                 Watermark="Search display / project / session id..."
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="11" />
                        <Button Grid.Column="1"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Margin="8,0,0,0"
                                FontFamily="{StaticResource MonoFont}"
                                FontSize="11" />
                    </Grid>
                    <Border Grid.Row="1"
                            BorderBrush="#222222"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryItemVm">
                                        <Border BorderBrush="#222222"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding ProjectPath}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11"
                                                               Foreground="#cccccc"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding LastActivityText}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10"
                                                               Foreground="#666666"
                                                               Margin="8,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding Display}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="#888888"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{Binding SessionId}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="9"
                                                               Foreground="#555555" />
                                                    <TextBlock Text="{Binding MessageCount, StringFormat='{}{0} msgs'}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="9"
                                                               Foreground="#555555" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="COST">
                <TextBlock Text="{Binding Cost.Placeholder}"
                           Foreground="#666666"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </TabItem>
            <TabItem Header="MEMORY">
                <Grid ColumnDefinitions="260,*" DataContext="{Binding Memory}" Margin="12">
                    <Border Grid.Column="0"
                            BorderBrush="#222222"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding Projects}"
                                     SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemoryProjectVm">
                                        <StackPanel Spacing="2" Margin="4">
                                            <TextBlock Text="{Binding DisplayPath}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       Foreground="#cccccc"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FileCountText}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9"
                                                       Foreground="#666666" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Column="1" Margin="12,0,0,0" RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                BorderBrush="#222222"
                                BorderThickness="1"
                                CornerRadius="4"
                                MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedProject.Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MemoryFileVm">
                                            <Button Background="Transparent"
                                                    BorderBrush="#222222"
                                                    BorderThickness="0,0,0,1"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="8,6"
                                                    Click="OnMemoryFileClick"
                                                    Tag="{Binding}">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="#cccccc" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1"
                                BorderBrush="#222222"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,8,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <SelectableTextBlock Text="{Binding SelectedFile.Content, FallbackValue='Select a file.'}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="11"
                                                     Foreground="#cccccc"
                                                     TextWrapping="Wrap"
                                                     Padding="12" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="SETTINGS">
                <TextBlock Text="{Binding Settings.Placeholder}"
                           Foreground="#666666"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
