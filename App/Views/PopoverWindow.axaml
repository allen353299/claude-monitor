<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClaudeMonitor.App.ViewModels"
        xmlns:theme="clr-namespace:ClaudeMonitor.App.Theme"
        mc:Ignorable="d"
        x:Class="ClaudeMonitor.App.Views.PopoverWindow"
        x:DataType="vm:PopoverViewModel"
        Width="320" Height="400"
        MinWidth="240" MinHeight="200"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="True"
        ShowInTaskbar="False"
        Title="ClaudeMonitor"
        Icon="avares://ClaudeMonitor.App/Assets/ClaudeMonitor.ico">

    <Window.Resources>
        <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Rectangle.dot-urgent">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.25" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Rectangle.glow-urgent">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.22" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button.session-card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0a0a0a" />
        </Style>
        <Style Selector="Button.session-card:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#141414" />
        </Style>

        <Style Selector="Rectangle.glow-done">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid>
    <Border Background="#D9000000"
            BorderBrush="#333333"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0"
                  x:Name="DragHandle"
                  Background="Transparent"
                  Cursor="SizeAll"
                  PointerPressed="OnDragHandlePressed"
                  ColumnDefinitions="*,Auto,Auto"
                  Margin="16,10">
                <TextBlock Grid.Column="0"
                           Text="{Binding SessionCountText}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="#666666"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        x:Name="PinButton"
                        Content="&#xE840;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Width="20" Height="20"
                        Padding="0"
                        Margin="0,0,4,0"
                        Background="Transparent"
                        Foreground="#ffffff"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Click="OnPinClick">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#222222" />
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Grid.Column="2"
                        Content="×"
                        Width="20" Height="20"
                        Padding="0"
                        Background="Transparent"
                        Foreground="#666666"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Click="OnCloseClick">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#222222" />
                            <Setter Property="Foreground" Value="#ffffff" />
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Background="#0a0a0a"
                    BorderBrush="#222222"
                    BorderThickness="0,1"
                    Padding="16,3"
                    Height="16">
                <ItemsControl ItemsSource="{Binding PixelBlocks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PixelBlock">
                            <Rectangle Fill="{Binding Color}"
                                       Margin="1,0"
                                       RadiusX="1" RadiusY="1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Grid.Row="2">
                <TextBlock Text="NO ACTIVE SESSIONS"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="#666666"
                           LetterSpacing="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsEmpty}" />

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding !IsEmpty}">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionVm">
                                <Button Classes="session-card"
                                        Background="Transparent"
                                        BorderBrush="#222222"
                                        BorderThickness="0,0,0,1"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        Cursor="Hand"
                                        CornerRadius="0"
                                        Opacity="{Binding CardOpacity}"
                                        IsEnabled="{Binding IsLive}"
                                        Command="{Binding $parent[ItemsControl].((vm:PopoverViewModel)DataContext).ActivateSessionCommand}"
                                        CommandParameter="{Binding Id}">
                                    <Grid>
                                        <Rectangle Fill="{x:Static theme:StatusPalette.Attention}"
                                                   Opacity="0"
                                                   IsHitTestVisible="False"
                                                   Classes.glow-urgent="{Binding ShouldGlowUrgent}" />
                                        <Rectangle Fill="{x:Static theme:StatusPalette.Done}"
                                                   Opacity="0"
                                                   IsHitTestVisible="False"
                                                   Classes.glow-done="{Binding ShouldGlowDone}" />
                                        <Border Padding="16,9">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Rectangle Width="6" Height="6"
                                                       Fill="{Binding StatusColor}"
                                                       Classes.dot-urgent="{Binding ShouldGlowUrgent}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SessionName}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#ffffff"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="#666666"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PendingTool}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="{x:Static theme:StatusPalette.Attention}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding PendingTool, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TitleOrFirstPrompt}"
                                                   Margin="14,0,0,0"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="#888888"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasTitleOrFirstPrompt}" />
                                        <TextBlock Text="{Binding RecapOrLatest}"
                                                   Margin="14,0,0,0"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="#666666"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasRecapOrLatest}" />
                                    </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>

    <Rectangle Tag="N"  HorizontalAlignment="Stretch" VerticalAlignment="Top"    Height="5" Margin="6,0"  Fill="Transparent" Cursor="SizeNorthSouth"         PointerPressed="OnResizePressed" />
    <Rectangle Tag="S"  HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="5" Margin="6,0"  Fill="Transparent" Cursor="SizeNorthSouth"         PointerPressed="OnResizePressed" />
    <Rectangle Tag="W"  HorizontalAlignment="Left"    VerticalAlignment="Stretch" Width="5" Margin="0,6"  Fill="Transparent" Cursor="SizeWestEast"           PointerPressed="OnResizePressed" />
    <Rectangle Tag="E"  HorizontalAlignment="Right"   VerticalAlignment="Stretch" Width="5" Margin="0,6"  Fill="Transparent" Cursor="SizeWestEast"           PointerPressed="OnResizePressed" />
    <Rectangle Tag="NW" HorizontalAlignment="Left"    VerticalAlignment="Top"    Width="8" Height="8"    Fill="Transparent" Cursor="TopLeftCorner"           PointerPressed="OnResizePressed" />
    <Rectangle Tag="NE" HorizontalAlignment="Right"   VerticalAlignment="Top"    Width="8" Height="8"    Fill="Transparent" Cursor="TopRightCorner"          PointerPressed="OnResizePressed" />
    <Rectangle Tag="SW" HorizontalAlignment="Left"    VerticalAlignment="Bottom" Width="8" Height="8"    Fill="Transparent" Cursor="BottomLeftCorner"        PointerPressed="OnResizePressed" />
    <Rectangle Tag="SE" HorizontalAlignment="Right"   VerticalAlignment="Bottom" Width="8" Height="8"    Fill="Transparent" Cursor="BottomRightCorner"       PointerPressed="OnResizePressed" />
    </Grid>
</Window>
