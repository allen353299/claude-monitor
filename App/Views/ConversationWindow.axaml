<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeMonitor.App.ViewModels"
        x:Class="ClaudeMonitor.App.Views.ConversationWindow"
        x:DataType="vm:ConversationViewModel"
        Width="800" Height="700"
        MinWidth="500" MinHeight="400"
        Background="#0f0f0f"
        Title="{Binding Title}"
        Icon="avares://ClaudeMonitor.App/Assets/ClaudeMonitor.ico">

    <Window.Resources>
        <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="#141414"
                BorderBrush="#222222"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#ffffff"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <CheckBox Grid.Column="1"
                          Content="thinking"
                          IsChecked="{Binding ShowThinking}"
                          Foreground="#888888"
                          FontFamily="{StaticResource MonoFont}"
                          FontSize="10"
                          Margin="12,0,0,0" />
                <CheckBox Grid.Column="2"
                          Content="tools"
                          IsChecked="{Binding ShowToolCalls}"
                          Foreground="#888888"
                          FontFamily="{StaticResource MonoFont}"
                          FontSize="10"
                          Margin="12,0,0,0" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
            <ItemsControl ItemsSource="{Binding VisibleMessages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageVm">
                        <Border BorderBrush="#222222"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,0,8"
                                Padding="10">
                            <StackPanel Spacing="4">
                                <Border Background="{Binding AccentColor}"
                                        Height="2"
                                        HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding Header}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10"
                                           Foreground="{Binding AccentColor}"
                                           FontWeight="SemiBold" />
                                <SelectableTextBlock Text="{Binding Body}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="11"
                                                     Foreground="#cccccc"
                                                     TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
